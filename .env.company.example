# Company Daily Device Round
DAILY_DEVICE_ROUND_ENABLED=false
DAILY_DEVICE_ROUND_CHANNEL_ID=
DAILY_DEVICE_ROUND_HOUR_KST=
DAILY_DEVICE_ROUND_MINUTE_KST=
