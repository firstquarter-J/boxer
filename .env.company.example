# Company LLM Policy
COMPANY_RETRIEVAL_SYSTEM_PROMPT=
COMPANY_FREEFORM_CORE_IDENTITY_PROMPT=
COMPANY_FREEFORM_RESPONSE_RULES_PROMPT=
COMPANY_FREEFORM_SYSTEM_PROMPT=
BARCODE_LOG_ERROR_SUMMARY_MAX_TOKENS=
RECORDING_FAILURE_ANALYSIS_MAX_TOKENS=

# Company APIs
# 내부 API service token은 Slack token과 분리하고 실제 값은 .env에만 둔다.
# 아래 host는 로컬 안전 기본값이다. production golden은 private SG 안에서
# Slack EC2가 접근할 수 있도록 0.0.0.0:8010을 명시해야 한다.
BOXER_COMPANY_API_HOST=127.0.0.1
BOXER_COMPANY_API_PORT=8010
BOXER_COMPANY_API_CALLERS_JSON=
# MDA/SSH 설정과 caller 권한을 모두 준비한 뒤에만 true로 켠다.
BOXER_COMPANY_API_LIVE_DEVICE_ENABLED=false
# PII/admin/write operations는 중앙 request-log와 caller 권한 준비 후 켠다.
BOXER_COMPANY_API_OPERATIONS_ENABLED=false
# 자동 리포터 cursor/in-flight/delivery state는 API EC2의 0600 JSON에 둔다.
BOXER_COMPANY_API_AUTOMATION_STATE_PATH=/var/lib/boxer-company-api/automation_state.json
# Slack service caller는 assistant.turn.read, assistant.device.probe,
# assistant.device.ssh.open, assistant.operation.execute,
# assistant.device.alert.execute, assistant.automation.transport,
# assistant.hpa.change.execute 일곱 capability만 정확히 가진다. domain cycle을
# 직접 실행하는 assistant.automation.execute는 scheduler 전환 뒤 주지 않는다.
# Slack adapter는 server caller registry의 token과 동일한 전용 값을
# 별도 환경변수로 받아 브라우저나 Slack token과 섞지 않는다.
BOXER_COMPANY_API_BASE_URL=
BOXER_COMPANY_API_SERVICE_TOKEN=
BOXER_COMPANY_API_CONNECT_TIMEOUT_SEC=2
BOXER_COMPANY_API_READ_TIMEOUT_SEC=90
# 기존 Agent install과 완료 poll이 각각 최대 10분이라 operation 전용 timeout을 쓴다.
BOXER_COMPANY_API_OPERATIONS_READ_TIMEOUT_SEC=1300
# 자동 주기 실행은 mutation 가능성이 있어 remote 단일 호출만 허용한다.
BOXER_COMPANY_API_AUTOMATION_READ_TIMEOUT_SEC=1800
BOXER_COMPANY_API_AUTOMATION_TENANT_ID=
BOXER_COMPANY_API_MAX_RETRIES=1
# Slack production entry는 모든 route를 remote로만 기동한다. local/shadow와
# fallback은 rollback 수단이 아니며 하나라도 설정되면 fail-closed한다.
BOXER_COMPANY_API_NOTION_MODE=remote
BOXER_COMPANY_API_NOTION_FALLBACK_ENABLED=false
# 병원·병실·영상·캡처 DB 조회와 장비 개수·존재 DB 조회는 API route를 분리한다.
# 비-count devices_filter와 generic 장비 상세·live 상태는 아래 전용
# device_detail 경계가 기존 DB+MDA+SSH 흐름으로 처리한다.
BOXER_COMPANY_API_STRUCTURED_MODE=remote
BOXER_COMPANY_API_STRUCTURED_FALLBACK_ENABLED=false
# LED 로그/패턴과 장비 개수, 날짜 지정 실패·로그 분석, 결정적 바코드
# 조회 결과는 route군별로 공통 API가 소유한다.
BOXER_COMPANY_API_DEVICE_MODE=remote
BOXER_COMPANY_API_DEVICE_FALLBACK_ENABLED=false
# generic 장비 정보는 remote에서 API가 기존 Slack과 같은 조회 결과를 만들되,
# 한 turn의 sshOrder는 최대 한 번만 보내고 poll resend·stale 강제 재개방은 막는다.
# HTTP transport는 자동 재시도·Slack-local fallback 없이 remote 한 번만 호출한다.
BOXER_COMPANY_API_DEVICE_DETAIL_MODE=remote
BOXER_COMPANY_API_DEVICE_DETAIL_FALLBACK_ENABLED=false
BOXER_COMPANY_API_RECORDING_FAILURE_MODE=remote
BOXER_COMPANY_API_RECORDING_FAILURE_FALLBACK_ENABLED=false
BOXER_COMPANY_API_BARCODE_LOG_MODE=remote
BOXER_COMPANY_API_BARCODE_LOG_FALLBACK_ENABLED=false
BOXER_COMPANY_API_BARCODE_MODE=remote
BOXER_COMPANY_API_BARCODE_FALLBACK_ENABLED=false
# 베이비매직 목록은 기존 결정적 바코드 5개와 별도 API route로 처리한다.
BOXER_COMPANY_API_BARCODE_RESIDUAL_MODE=remote
BOXER_COMPANY_API_BARCODE_RESIDUAL_FALLBACK_ENABLED=false
# 마지막 녹화일·날짜별 녹화 존재 조회는 LLM 합성 계약과 별도 route로 처리한다.
BOXER_COMPANY_API_BARCODE_TIMELINE_MODE=remote
BOXER_COMPANY_API_BARCODE_TIMELINE_FALLBACK_ENABLED=false
# recordings 근거 해석형 바코드 질문은 결정적 route와 분리한다.
BOXER_COMPANY_API_BARCODE_FREEFORM_MODE=remote
BOXER_COMPANY_API_BARCODE_FREEFORM_FALLBACK_ENABLED=false
# 모든 근거 route 뒤의 일반 회사 대화도 API provider가 처리한다.
BOXER_COMPANY_API_FREEFORM_MODE=remote
BOXER_COMPANY_API_FREEFORM_FALLBACK_ENABLED=false
# 운영 플레이북 조회·근거 합성은 다른 knowledge route와 분리한다.
BOXER_COMPANY_API_PLAYBOOK_MODE=remote
BOXER_COMPANY_API_PLAYBOOK_FALLBACK_ENABLED=false
# 주간 요약 조회는 운영 플레이북과 독립된 API route가 처리한다.
BOXER_COMPANY_API_WEEKLY_SUMMARY_MODE=remote
BOXER_COMPANY_API_WEEKLY_SUMMARY_FALLBACK_ENABLED=false
# 장비 변경·PII/admin·학습은 공통 API를 한 번만 호출한다.
BOXER_COMPANY_API_OPERATIONS_MODE=remote
BOXER_COMPANY_API_OPERATIONS_FALLBACK_ENABLED=false
BOXER_COMPANY_API_AUTOMATION_MODE=remote
BOXER_COMPANY_API_AUTOMATION_FALLBACK_ENABLED=false
# API가 소유하는 다섯 cycle exact set이다. 누락·중복·부분 소유권은 거부한다.
BOXER_COMPANY_API_AUTOMATION_REMOTE_CYCLES=weekly_recordings,daily_device_round,device_health_monitor,device_notification_alert,sms_delivery
# Slack은 domain payload가 아닌 전송 receipt만 이 절대·writable journal에 둔다.
BOXER_COMPANY_AUTOMATION_DELIVERY_STATE_PATH=/home/ec2-user/rag-bot/data/company_automation_delivery_state.json
# API remote turn 감사와 admin request-log 조회는 systemd StateDirectory의
# 같은 SQLite를 사용한다. Slack EC2의 기존 SQLite는 새 요청 정본이 아니다.
REQUEST_LOG_SQLITE_ENABLED=true
REQUEST_LOG_SQLITE_PATH=/var/lib/boxer-company-api/request_log.db
REQUEST_LOG_SQLITE_TIMEOUT_SEC=2
REQUEST_LOG_SQLITE_BUSY_TIMEOUT_MS=5000
REQUEST_LOG_SQLITE_INIT_ON_STARTUP=true
REQUEST_LOG_TIMEZONE=Asia/Seoul
REQUEST_LOG_SQLITE_S3_BACKUP_ENABLED=false
REQUEST_LOG_SQLITE_S3_BACKUP_BUCKET=
REQUEST_LOG_SQLITE_S3_OBJECT_KEY=boxer-request-log.db
REQUEST_LOG_SQLITE_S3_PREFIX=
REQUEST_LOG_SQLITE_S3_STORAGE_CLASS=
REQUEST_LOG_SQLITE_S3_SERVER_SIDE_ENCRYPTION=
REQUEST_LOG_SQLITE_S3_RESTORE_ON_STARTUP=false
# API instance role을 S3 GetObject-only로 유지할 때만 true로 둔다.
BOXER_COMPANY_API_S3_HEAD_403_AS_MISSING=false
APP_USER_API_URL=
APP_USER_API_TIMEOUT_SEC=
# API generic 장비 상세은 아래 MDA 설정으로 메타데이터와 Redis-backed
# agentSsh 상태를 조회하고, endpoint가 없을 때 MDA_SSH_OPEN_HOST로 tunnel
# open을 한 번만 요청한다.
MDA_GRAPHQL_URL=
MDA_ADMIN_USER_PASSWORD=
MDA_SSH_OPEN_HOST=
MDA_GRAPHQL_ORIGIN=
MDA_GRAPHQL_REFERER=
MDA_GRAPHQL_USER_AGENT=
MDA_API_TIMEOUT_SEC=
MDA_SSH_POLL_INTERVAL_SEC=
MDA_SSH_POLL_TIMEOUT_SEC=
MDA_SSH_POLL_RESEND_EVERY=

# Company Policy
HYUN_USER_ID=
