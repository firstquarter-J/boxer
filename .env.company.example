# Company LED Monitor (상태 이전 호환을 위해 DEVICE_HEALTH_MONITOR 식별자 유지)
# ENABLED는 LED 감지 cycle을 제어한다. ALERTS_ENABLED는 legacy/초기 전달
# 기본값이며 remote 전환 뒤 전달 정본은 API durable override다.
DEVICE_HEALTH_MONITOR_ENABLED=false
DEVICE_HEALTH_MONITOR_ALERTS_ENABLED=false
DEVICE_HEALTH_MONITOR_CHANNEL_ID=
DEVICE_HEALTH_MONITOR_POLL_INTERVAL_SEC=
DEVICE_HEALTH_MONITOR_ALERT_REMINDER_HOURS=
DEVICE_HEALTH_MONITOR_REDIS_STALE_SEC=
DEVICE_HEALTH_MONITOR_REDIS_STANDBY_STALE_SEC=1500
DEVICE_HEALTH_MONITOR_DEVICE_CACHE_TTL_SEC=
DEVICE_HEALTH_MONITOR_SSH_OPEN_WAIT_SEC=
DEVICE_HEALTH_MONITOR_SSH_OPEN_POLL_INTERVAL_SEC=
DEVICE_HEALTH_MONITOR_STATE_PATH=
DEVICE_HEALTH_MONITOR_EVENT_LOG_DIR=/var/lib/boxer-company-api/device-health-events
DEVICE_HEALTH_MONITOR_EVENT_LOG_RETENTION_DAYS=14
DEVICE_HEALTH_MONITOR_EVENT_LOG_ARCHIVE_S3_BUCKET=
DEVICE_HEALTH_MONITOR_EVENT_LOG_ARCHIVE_S3_PREFIX=device-health-monitor/events
DEVICE_HEALTH_MONITOR_UNAVAILABLE_EVENT_SUMMARY_HOURS=6
DEVICE_NOTIFICATION_ALERT_ENABLED=false
DEVICE_NOTIFICATION_ALERT_CHANNEL_ID=
DEVICE_NOTIFICATION_ALERT_POLL_INTERVAL_SEC=30
# 같은 캡처보드 반복 장애를 새 루트로 만들지 않는 sliding quiet window다.
# 허용 범위는 60~86400초다.
DEVICE_NOTIFICATION_CAPTUREBOARD_INCIDENT_QUIET_SEC=600
DEVICE_NOTIFICATION_ALERT_STATE_PATH=
# 신규 자동 문자를 끈 뒤에도 API outbox가 빌 때까지 true로 유지한다.
SMS_DELIVERY_REPORTER_ENABLED=false

# API companion이 일정과 domain cycle을 소유할 때만 켠다. 운영 Slack entry도
# true를 요구하며 delivery pull/ACK만 수행하고 automation execute capability를
# 갖지 않는다. 첫 배포·상태 이전 중에는 false로 두고 API 쪽부터 검증한다.
BOXER_COMPANY_API_AUTOMATION_SCHEDULER_ENABLED=false
BOXER_COMPANY_API_AUTOMATION_SCHEDULER_POLL_INTERVAL_SEC=5
DEVICE_HEALTH_SHEET_ENABLED=false
DEVICE_HEALTH_SHEET_SPREADSHEET_ID=
DEVICE_HEALTH_SHEET_TAB_NAME=Boxer 장애 감지 처리 현황
DEVICE_HEALTH_SHEET_TIMEOUT_SEC=10
# Sheet 활성 시 root-owned·service-readable ADC 파일의 절대 경로만 허용한다.
GOOGLE_APPLICATION_CREDENTIALS=/etc/boxer-company-api/google-application-credentials.json
DEVICE_HEALTH_MONITOR_CONTACT_WEBHOOK_URL=
DEVICE_HEALTH_MONITOR_SMS_WEBHOOK_URL=
DEVICE_HEALTH_MONITOR_SMS_PROVIDER=none
DEVICE_HEALTH_MONITOR_SMS_TEST_PHONE_NUMBER=
DEVICE_HEALTH_MONITOR_VOICE_GUIDE_WEBHOOK_URL=
DEVICE_HEALTH_MONITOR_ACTION_WEBHOOK_TIMEOUT_SEC=
DEVICE_HEALTH_MONITOR_VOICE_GUIDE_COOLDOWN_SEC=10
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_FROM_NUMBER=
SOLAPI_BASE_URL=
SOLAPI_DELIVERY_REPORT_POLL_INTERVAL_SEC=30
SOLAPI_DELIVERY_REPORT_MAX_AGE_HOURS=48
# health/notification claim·Solapi alert·receipt drain을 켤 때만 이 고정 0600 경로를 요구한다.
SMS_DELIVERY_OUTBOX_PATH=/var/lib/boxer-company-api/sms_delivery_outbox.json
SMS_DELIVERY_OUTBOX_REPAIR_GRACE_SEC=60
DEVICE_STATE_REDIS_HOST=
DEVICE_STATE_REDIS_PORT=6379
DEVICE_STATE_REDIS_PASSWORD=
DEVICE_STATE_REDIS_TLS=false
