BOXER_BASE_ACCESS_STATE_PATH=data/boxer_base_access.json
RECORDING_STREAMING_RESTORE_ENABLED=
THREAD_PLAYBOOK_LEARNING_ENABLED=true
NOTION_TOKEN_COMPANY=
COMPANY_NOTION_SEARCH_ROOT_PAGE_ID=
COMPANY_NOTION_SEARCH_MAX_RESULTS=5
COMPANY_NOTION_SEARCH_MAX_CANDIDATES=10
COMPANY_NOTION_SEARCH_PARENT_MAX_DEPTH=12
COMPANY_NOTION_ANSWER_MAX_PAGES=3
