THREAD_PLAYBOOK_NOTION_KIND=runbook
THREAD_PLAYBOOK_NOTION_PRIORITY=high
THREAD_PLAYBOOK_LEARNING_FETCH_LIMIT=100
THREAD_PLAYBOOK_LEARNING_MAX_THREAD_CHARS=12000
THREAD_PLAYBOOK_LEARNING_MAX_TOKENS=900

# HPA Change Request -> API coordinator -> isolated GitHub Actions worker
HPA_CHANGE_REQUEST_ENABLED=false
# Slack은 membership/thread/첨부 수집과 결과 전달만 맡고, 아래 GitHub 인증과
# SQLite state는 API EC2와 API companion에서만 읽는다.
# 요청자는 Boxer 기본 사용자 권한을 따르고, HPA 전용 채널·worker 경계는 유지한다.
HPA_CHANGE_REQUEST_ALLOWED_CHANNEL_IDS=C02C08K7YEN,C068FVD5V7Y
HPA_CHANGE_GITHUB_COORDINATOR_REPOSITORY=mmtalk-app/mmb-hospital-admin-server
HPA_CHANGE_GITHUB_WORKFLOW_FILE=boxer-hpa-change.yml
HPA_CHANGE_GITHUB_API_URL=https://api.github.com
HPA_CHANGE_GITHUB_TOKEN=
HPA_CHANGE_GITHUB_APP_ID=
HPA_CHANGE_GITHUB_APP_INSTALLATION_ID=
HPA_CHANGE_GITHUB_APP_PRIVATE_KEY_PATH=
HPA_CHANGE_JOB_DB_PATH=
HPA_CHANGE_POLL_INTERVAL_SEC=20
HPA_CHANGE_RUN_TIMEOUT_SEC=10800
HPA_CHANGE_MAX_THREAD_CHARS=30000
HPA_CHANGE_MAX_FILES=5
HPA_CHANGE_MAX_FILE_BYTES=131072
HPA_CHANGE_MAX_TOTAL_ATTACHMENT_BYTES=524288

