# Company LLM Policy
COMPANY_RETRIEVAL_SYSTEM_PROMPT=
COMPANY_FREEFORM_CORE_IDENTITY_PROMPT=
COMPANY_FREEFORM_RESPONSE_RULES_PROMPT=
COMPANY_FREEFORM_SYSTEM_PROMPT=
BARCODE_LOG_ERROR_SUMMARY_MAX_TOKENS=
RECORDING_FAILURE_ANALYSIS_MAX_TOKENS=

# Company APIs
# 내부 API service token은 Slack token과 분리하고 실제 값은 .env에만 둔다.
BOXER_COMPANY_API_HOST=127.0.0.1
BOXER_COMPANY_API_PORT=8010
BOXER_COMPANY_API_CALLERS_JSON=
# Slack adapter는 server caller registry의 token과 동일한 전용 값을
# 별도 환경변수로 받아 브라우저나 Slack token과 섞지 않는다.
BOXER_COMPANY_API_BASE_URL=
BOXER_COMPANY_API_SERVICE_TOKEN=
BOXER_COMPANY_API_CONNECT_TIMEOUT_SEC=2
BOXER_COMPANY_API_READ_TIMEOUT_SEC=90
BOXER_COMPANY_API_MAX_RETRIES=1
BOXER_COMPANY_API_NOTION_MODE=local
BOXER_COMPANY_API_NOTION_FALLBACK_ENABLED=false
# 병원·병실·영상·캡처 DB 조회와 장비 개수 DB 조회를 독립 전환한다.
# 장비의 실시간 status와 MDA·SSH 보강은 Slack local에 유지한다.
BOXER_COMPANY_API_STRUCTURED_MODE=local
BOXER_COMPANY_API_STRUCTURED_FALLBACK_ENABLED=false
# LED 로그/패턴과 장비 개수, 날짜 지정 실패·로그 분석, 결정적 바코드
# 조회를 route군별로 local -> shadow -> remote 전환한다.
BOXER_COMPANY_API_DEVICE_MODE=local
BOXER_COMPANY_API_DEVICE_FALLBACK_ENABLED=false
# devices DB-only 상세는 장비 개수·LED 조회와 독립 전환한다.
BOXER_COMPANY_API_DEVICE_DETAIL_MODE=local
BOXER_COMPANY_API_DEVICE_DETAIL_FALLBACK_ENABLED=false
BOXER_COMPANY_API_RECORDING_FAILURE_MODE=local
BOXER_COMPANY_API_RECORDING_FAILURE_FALLBACK_ENABLED=false
BOXER_COMPANY_API_BARCODE_LOG_MODE=local
BOXER_COMPANY_API_BARCODE_LOG_FALLBACK_ENABLED=false
BOXER_COMPANY_API_BARCODE_MODE=local
BOXER_COMPANY_API_BARCODE_FALLBACK_ENABLED=false
# 베이비매직 목록은 기존 결정적 바코드 5개와 따로 전환한다.
BOXER_COMPANY_API_BARCODE_RESIDUAL_MODE=local
BOXER_COMPANY_API_BARCODE_RESIDUAL_FALLBACK_ENABLED=false
# 마지막 녹화일·날짜별 녹화 존재 조회는 LLM 합성 계약과 함께 따로 전환한다.
BOXER_COMPANY_API_BARCODE_TIMELINE_MODE=local
BOXER_COMPANY_API_BARCODE_TIMELINE_FALLBACK_ENABLED=false
# recordings 근거 해석형 바코드 질문만 결정적 route와 독립 전환한다.
BOXER_COMPANY_API_BARCODE_FREEFORM_MODE=local
BOXER_COMPANY_API_BARCODE_FREEFORM_FALLBACK_ENABLED=false
# 운영 플레이북 조회·근거 합성은 다른 knowledge route와 분리해 전환한다.
BOXER_COMPANY_API_PLAYBOOK_MODE=local
BOXER_COMPANY_API_PLAYBOOK_FALLBACK_ENABLED=false
# 주간 요약 조회는 운영 플레이북과 독립 전환한다.
BOXER_COMPANY_API_WEEKLY_SUMMARY_MODE=local
BOXER_COMPANY_API_WEEKLY_SUMMARY_FALLBACK_ENABLED=false
# API instance role을 S3 GetObject-only로 유지할 때만 true로 둔다.
BOXER_COMPANY_API_S3_HEAD_403_AS_MISSING=false
APP_USER_API_URL=
APP_USER_API_TIMEOUT_SEC=
MDA_GRAPHQL_URL=
MDA_ADMIN_USER_PASSWORD=
MDA_SSH_OPEN_HOST=
MDA_GRAPHQL_ORIGIN=
